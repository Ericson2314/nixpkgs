From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: John Ericson <John.Ericson@Obsidian.Systems>
Date: Fri, 7 Aug 2026 17:30:31 -0400
Subject: [PATCH] libc: build without commpage, CTF-derived offsets, or Sun
 `as`

Several obstacles to building libc off illumos:

- The comm page makefiles assume the full in-tree build; skip them for now.
- `assym.h` is normally produced by `$(OFFSETS_CREATE)` from `offsets.in`,
  which needs `ctfstabs`. `genassym` alone covers what the bootstrap needs.
  Note the prerequisite on genassym must be kept: commenting out the whole
  list stops genassym from being built at all.
- `cerror.S` opens a comment with a bare `/`, which only the Sun assembler
  accepts. `//` means the same to it and to the GNU assembler.
- Keep `$(CPPFLAGS.first)` when redefining CPPFLAGS. Makefile.master
  documents it as the hook for putting include directories ahead of
  everything else, and replacing CPPFLAGS outright silently dropped it.
- Drop the redundant `-I$(LIBCBASE)/../port/regex` from the regex rules in
  Makefile.targ. Every local header in port/regex is included with quotes
  ("regex.h", "regex2.h", "utils.h", "cname.h"), which already resolves
  relative to the including file, so the -I adds nothing -- but it does put
  libc private regex.h ahead of the public <regex.h>, which defines
  regex_t and the REG_* codes that regcomp.c needs.
---
 usr/src/lib/libc/Makefile.targ                |  2 -
 usr/src/lib/libc/amd64/Makefile               | 34 ++++++++++----
 usr/src/lib/libc/amd64/crt/cerror.S           |  2 +-
 usr/src/lib/libc/amd64/genassym.c             | 46 +++++++++++++++++++
 .../lib/libc/port/threads/plockstat_stub.c    | 38 +++++++++++++++
 5 files changed, 111 insertions(+), 11 deletions(-)
 create mode 100644 usr/src/lib/libc/port/threads/plockstat_stub.c

diff --git a/usr/src/lib/libc/Makefile.targ b/usr/src/lib/libc/Makefile.targ
index ebb8af11e3..742aaa805f 100644
--- a/usr/src/lib/libc/Makefile.targ
+++ b/usr/src/lib/libc/Makefile.targ
@@ -141,7 +141,6 @@ pics/%64.o: $(LIBCBASE)/../port/print/%.c
 
 pics/%64.o: $(LIBCBASE)/../port/regex/%.c
 	$(COMPILE.c) -DM_I18N_MB -DI18N \
-	-I$(LIBCBASE)/../port/regex \
 	-I$(LIBCBASE)/../port/gen -o $@ $<
 	$(POST_PROCESS_O)
 
@@ -208,7 +207,6 @@ pics/%.o: $(LIBCBASE)/../port/print/%.c
 # regex rules
 pics/%.o: $(LIBCBASE)/../port/regex/%.c
 	$(COMPILE.c) -DM_I18N_MB -DI18N \
-	-I$(LIBCBASE)/../port/regex \
 	-I$(LIBCBASE)/../port/gen -o $@ $<
 	$(POST_PROCESS_O)
 
diff --git a/usr/src/lib/libc/amd64/Makefile b/usr/src/lib/libc/amd64/Makefile
index ba71bcfdbd..48b2e10ed1 100644
--- a/usr/src/lib/libc/amd64/Makefile
+++ b/usr/src/lib/libc/amd64/Makefile
@@ -870,7 +870,8 @@ THREADSOBJS=			\
 	thr.o			\
 	thread_interface.o	\
 	tls.o			\
-	tsd.o
+	tsd.o			\
+	plockstat_stub.o
 
 THREADSMACHOBJS=		\
 	machdep.o
@@ -1072,7 +1073,13 @@ $(DYNLIB) := BUILD.SO = $(LD) -o $@ $(GSHARED) $(DYNFLAGS) $(PICS) $(ALTPICS) $(
 
 MAPFILES =	$(LIBCDIR)/port/mapfile-vers
 
-CPPFLAGS=	-D_REENTRANT -D$(MACH64) -D__$(MACH64) $(THREAD_DEBUG) \
+# $(CPPFLAGS.first) is kept: Makefile.master documents it as the hook for
+# lower makefiles to put include directories ahead of everything else, and
+# replacing CPPFLAGS outright would silently drop it. A cross-build needs it to
+# place the installed headers before the -I flags that individual rules in
+# Makefile.targ add -- notably ../port/regex, which holds a private regex.h.
+CPPFLAGS=	$(CPPFLAGS.first) \
+		-D_REENTRANT -D$(MACH64) -D__$(MACH64) $(THREAD_DEBUG) \
 		-I. -I$(LIBCBASE)/inc -I$(LIBCDIR)/inc $(CPPFLAGS.master)
 
 # __XOPEN_OR_POSIX is necessary to avoid implicit _LARGEFILE_SOURCE which
@@ -1107,10 +1114,18 @@ BUILD.s=	$(AS) $(ASFLAGS) $< -c -o $@
 CSTD=	$(CSTD_GNU99)
 
 # libc method of building an archive
-# The "$(GREP) -v ' L '" part is necessary only until
-# lorder is fixed to ignore thread-local variables.
+#
+# Upstream orders the members with lorder(1) | tsort(1) so that a single-pass
+# link resolves. lorder parses nm(1) output in Solaris' format, which a GNU nm
+# does not quite match: the dependency pairs come out unbalanced and tsort
+# rejects the input with "odd number of tokens", leaving an *empty* archive
+# and a build that appears to have succeeded.
+#
+# The ordering is not actually needed here. `ar -ts` runs immediately after
+# and writes a symbol table, and every linker we care about resolves archive
+# members through that index rather than by member order.
 BUILD.AR= $(RM) $@ ; \
-	$(AR) q $@ `$(LORDER) $(MOSTOBJS:%=$(DIR)/%) | $(GREP) -v ' L ' | $(TSORT)`
+	$(AR) q $@ $(MOSTOBJS:%=$(DIR)/%)
 
 # extra files for the clean target
 CLEANFILES +=			\
@@ -1215,10 +1230,13 @@ genassym: $(GENASSYM_C)
 	$(NATIVECC) $(NATIVE_CFLAGS) -Iinc -I$(LIBCDIR)/inc $(CPPFLAGS.native) \
 		$(LDFLAGS.native) -o $@ $(GENASSYM_C)
 
-OFFSETS = $(LIBCDIR)/$(MACH)/offsets.in
+#OFFSETS = $(LIBCDIR)/$(MACH)/offsets.in
 
-assym.h: $(OFFSETS) genassym
-	$(OFFSETS_CREATE) <$(OFFSETS) >$@
+# $(OFFSETS_CREATE) needs ctfstabs, which is not available when cross-building,
+# so assym.h is generated from genassym alone. Note that the prerequisite on
+# genassym itself must be kept: commenting out the whole list stops genassym
+# from ever being built, and the recipe then runs a ./genassym that is absent.
+assym.h: genassym
 	./genassym >>$@
 
 # derived C source and related explicit dependencies
diff --git a/usr/src/lib/libc/amd64/crt/cerror.S b/usr/src/lib/libc/amd64/crt/cerror.S
index f019a4a1b1..f0604e0aae 100644
--- a/usr/src/lib/libc/amd64/crt/cerror.S
+++ b/usr/src/lib/libc/amd64/crt/cerror.S
@@ -26,7 +26,7 @@
 
 	.file	"cerror.s"
 
-/ C return sequence which sets errno, returns -1.
+// C return sequence which sets errno, returns -1.
 
 #include <SYS.h>
 
diff --git a/usr/src/lib/libc/amd64/genassym.c b/usr/src/lib/libc/amd64/genassym.c
index b20d944c05..ad950693ed 100644
--- a/usr/src/lib/libc/amd64/genassym.c
+++ b/usr/src/lib/libc/amd64/genassym.c
@@ -28,7 +28,9 @@
 #include <stdio.h>
 #include <stddef.h>
 #include <signal.h>
+#include <setjmp.h>
 #include <ucontext.h>
+#include "libc_int.h"
 #include <sys/stack.h>
 #include <sys/synch.h>
 #include <sys/synch32.h>
@@ -61,5 +63,49 @@ main(void)
 	(void) printf("#define\tRAX_OFF\t0x%x\n", REG_RAX * 8);
 	(void) printf("#define\tRSP_OFF\t0x%x\n", REG_RSP * 8);
 
+	/*
+	 * The values below are normally produced from $(LIBCDIR)/$(MACH)/
+	 * offsets.in by $(OFFSETS_CREATE), which drives ctfstabs and so needs
+	 * CTF data. That is not available when cross-building, so emit them
+	 * here instead -- they are all plain sizeof/offsetof over the same
+	 * headers ctfstabs would have read. Keep this list in sync with
+	 * offsets.in.
+	 */
+	(void) printf("#define\tSIZEOF_TLS_T\t0x%zx\n", sizeof (tls_t));
+	(void) printf("#define\tSIZEOF_UCONTEXT_T\t0x%zx\n",
+	    sizeof (ucontext_t));
+	(void) printf("#define\tSIZEOF_SIGJMP_BUF\t0x%zx\n",
+	    sizeof (sigjmp_buf));
+
+	(void) printf("#define\tTI_MODULEID\t0x%zx\n",
+	    offsetof(TLS_index, ti_moduleid));
+	(void) printf("#define\tTI_TLSOFFSET\t0x%zx\n",
+	    offsetof(TLS_index, ti_tlsoffset));
+
+	(void) printf("#define\tTLS_DATA\t0x%zx\n", offsetof(tls_t, tls_data));
+
+	(void) printf("#define\tSS_SP\t0x%zx\n", offsetof(stack_t, ss_sp));
+	(void) printf("#define\tSS_SIZE\t0x%zx\n", offsetof(stack_t, ss_size));
+
+	(void) printf("#define\tUC_MCONTEXT_GREGS\t0x%zx\n",
+	    offsetof(ucontext_t, uc_mcontext.gregs));
+
+	(void) printf("#define\tUL_TLSENT\t0x%zx\n",
+	    offsetof(ulwp_t, ul_tlsent));
+	(void) printf("#define\tUL_NTLSENT\t0x%zx\n",
+	    offsetof(ulwp_t, ul_ntlsent));
+	(void) printf("#define\tUL_USTACK\t0x%zx\n",
+	    offsetof(ulwp_t, ul_ustack));
+	(void) printf("#define\tUL_VFORK\t0x%zx\n",
+	    offsetof(ulwp_t, ul_vfork));
+	(void) printf("#define\tUL_SCHEDCTL_CALLED\t0x%zx\n",
+	    offsetof(ulwp_t, ul_schedctl_called));
+	(void) printf("#define\tUL_SCHEDCTL\t0x%zx\n",
+	    offsetof(ulwp_t, ul_schedctl));
+	(void) printf("#define\tUL_SIGLINK\t0x%zx\n",
+	    offsetof(ulwp_t, ul_siglink));
+	(void) printf("#define\tUL_SIGMASK\t0x%zx\n",
+	    offsetof(ulwp_t, ul_sigmask));
+
 	return (0);
 }
diff --git a/usr/src/lib/libc/port/threads/plockstat_stub.c b/usr/src/lib/libc/port/threads/plockstat_stub.c
new file mode 100644
index 0000000000..75833a662d
--- /dev/null
+++ b/usr/src/lib/libc/port/threads/plockstat_stub.c
@@ -0,0 +1,38 @@
+/*
+ * This file and its contents are supplied under the terms of the
+ * Common Development and Distribution License ("CDDL"), version 1.0.
+ * You may only use this file in accordance with the terms of version
+ * 1.0 of the CDDL.
+ *
+ * A full copy of the text of the CDDL should have accompanied this
+ * source.  A copy of the CDDL is also available via the Internet at
+ * http://www.illumos.org/license/CDDL.
+ */
+
+/*
+ * Stub definitions for the plockstat USDT probes.
+ *
+ * Normally these symbols come from plockstat.o, which `dtrace -G` generates
+ * from port/threads/plockstat.d; dtrace patches the call sites into nops, so
+ * the probes cost nothing when not enabled. dtrace is not available when
+ * cross-building libc from a non-illumos host, so define the probe functions
+ * as empty instead. The result is a libc that behaves identically except that
+ * the plockstat provider reports nothing.
+ *
+ * The parameter lists are deliberately unspecified: the call sites pass
+ * varying numbers of arguments, and an empty function is a valid target for
+ * all of them under the SysV AMD64 calling convention.
+ */
+
+void __dtrace_plockstat___mutex__acquire() {}
+void __dtrace_plockstat___mutex__block() {}
+void __dtrace_plockstat___mutex__blocked() {}
+void __dtrace_plockstat___mutex__error() {}
+void __dtrace_plockstat___mutex__release() {}
+void __dtrace_plockstat___mutex__spin() {}
+void __dtrace_plockstat___mutex__spun() {}
+void __dtrace_plockstat___rw__acquire() {}
+void __dtrace_plockstat___rw__block() {}
+void __dtrace_plockstat___rw__blocked() {}
+void __dtrace_plockstat___rw__error() {}
+void __dtrace_plockstat___rw__release() {}
