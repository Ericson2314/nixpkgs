From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: John Ericson <John.Ericson@Obsidian.Systems>
Date: Fri, 7 Aug 2026 17:30:31 -0400
Subject: [PATCH] lib/Makefile.lib: disable PIC objects and CTF post-processing

Two things the bootstrap libc build cannot yet do:

- `PICS` drives the shared-library build. `libcMinimal` only needs the
  static archive, and building the PIC objects pulls in machinery that is
  not ready yet.
- `POST_PROCESS_O`/`POST_PROCESS_SO` run `ctfconvert`/`ctfmerge`. The CTF
  tools are not packaged for the cross build, and CTF is not needed to get
  a working libc.

Both need to come back for a real `libc.so.1`; this is a bootstrap step.
---
 usr/src/lib/Makefile.lib | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/usr/src/lib/Makefile.lib b/usr/src/lib/Makefile.lib
index 24f1919264..68d3db2e54 100644
--- a/usr/src/lib/Makefile.lib
+++ b/usr/src/lib/Makefile.lib
@@ -140,7 +140,7 @@ DYNFLAGS=	$(HSONAME) $(ZTEXT) $(ZDEFS) $(BDIRECT) \
 LDLIBS=		$(LDLIBS.lib)
 
 OBJS=		$(OBJECTS:%=objs/%)
-PICS=		$(OBJECTS:%=pics/%)
+PICS=		#$(OBJECTS:%=pics/%)
 
 # Declare that all library .o's can all be made in parallel.
 # The DUMMY target is for those instances where OBJS and PICS
@@ -188,8 +188,8 @@ LDLIBS +=	$(LDSTACKPROTECT)
 #
 CTFCONVERT_POST = :
 CTFMERGE_POST	= :
-POST_PROCESS_O += ; $(CTFCONVERT_POST)
-POST_PROCESS_SO += ; $(CTFMERGE_POST)
+#POST_PROCESS_O += ; $(CTFCONVERT_POST)
+#POST_PROCESS_SO += ; $(CTFMERGE_POST)
 
 CTFMERGE_LIB	= $(CTFMERGE) $(CTFMRGFLAGS) -t -f -L VERSION -o $@ $(PICS)
 
