From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: John Ericson <John.Ericson@Obsidian.Systems>
Date: Tue, 18 Aug 2026 02:25:52 -0400
Subject: [PATCH] tools/libcompat: gather <syms.h> and <storclass.h>

cmd/sgs/libelf/misc/nlist.c includes <syms.h>, which includes <storclass.h>.

Assisted-By: Claude Opus 5 (claude-opus-5)
---
 usr/src/tools/libcompat/Makefile | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/usr/src/tools/libcompat/Makefile b/usr/src/tools/libcompat/Makefile
index 5d96c30282..53b8b060bd 100644
--- a/usr/src/tools/libcompat/Makefile
+++ b/usr/src/tools/libcompat/Makefile
@@ -114,7 +114,9 @@ HEADHDRS=	elf.h \
 		proc_service.h \
 		rtld_db.h \
 		link.h \
-		nlist.h
+		nlist.h \
+		syms.h \
+		storclass.h
 
 HDRS=		$(SYSHDRS:%=include/%) $(MACHSYSHDRS:%=include/%) \
 		$(HEADHDRS:%=include/%)
