+/* ARGSUSED */
+static int
+virtiofs_access(vnode_t *vp, int mode, int flags, cred_t *cr,
+    caller_context_t *ct)
+{
+	return (virtiofs_taccess(vp, (mode_t)mode, cr));
+}
