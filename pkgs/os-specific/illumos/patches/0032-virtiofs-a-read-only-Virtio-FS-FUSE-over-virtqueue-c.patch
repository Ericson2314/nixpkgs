+/* ARGSUSED */
+static int
+virtiofs_getattr(vnode_t *vp, vattr_t *vap, int flags, cred_t *cr,
+    caller_context_t *ct)
+{
+	vfnode_t *vfn = VTOVF(vp);
+	struct fuse_attr fa;
+	int r;
+
+	if ((r = virtiofs_node_getattr(vfn, &fa)) != 0)
+		return (r);
+
+	virtiofs_attr_to_vattr(vfn->vfn_mnt, &fa, vap);
+
+	return (0);
+}
