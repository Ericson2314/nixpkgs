diff --git a/usr/src/cmd/sgs/libld/common/debug.c b/usr/src/cmd/sgs/libld/common/debug.c
index a42c0a6ec9..c2b66cd2e8 100644
--- a/usr/src/cmd/sgs/libld/common/debug.c
+++ b/usr/src/cmd/sgs/libld/common/debug.c
@@ -24,6 +24,7 @@
  */
 
 #include	<stdio.h>
+#include	<sys/time.h>
 #include	<stdarg.h>
 #include	<errno.h>
 #include	<strings.h>
@@ -58,10 +59,23 @@ static struct {
 	FILE	*fptr;	/* File to send debug output */
 	int	close_needed;	/* True if explicitly opened stream */
 } dbg_ofile = {
-	stderr,
+	NULL,		/* filled in on first use; see dbg_ofile_fptr() */
 	0
 };
 
+/*
+ * stderr is not necessarily a constant expression -- on some C libraries it
+ * is a variable, not an address in a static array -- so dbg_ofile.fptr cannot
+ * be initialised to it statically.  Default it on first use instead.
+ */
+static FILE *
+dbg_ofile_fptr(void)
+{
+	if (dbg_ofile.fptr == NULL)
+		dbg_ofile.fptr = stderr;
+	return (dbg_ofile.fptr);
+}
+
 
 /*
  * If there is an explicitly opened debug file, close it and reset the state.
@@ -70,7 +84,7 @@ void
 dbg_cleanup(void)
 {
 	if (dbg_ofile.close_needed) {
-		(void) fclose(dbg_ofile.fptr);
+		(void) fclose(dbg_ofile_fptr());
 		dbg_ofile.close_needed = 0;
 		dbg_ofile.fptr = stderr;
 	}
@@ -204,9 +218,9 @@ dbg_print(Lm_list *lml, const char *format, ...)
 			}
 		}
 		(void) fputs(prestr ? prestr : MSG_INTL(MSG_DBG_AOUT_FMT),
-		    dbg_ofile.fptr);
+		    dbg_ofile_fptr());
 	} else
-		(void) fputs(MSG_INTL(MSG_DBG_DFLT_FMT), dbg_ofile.fptr);
+		(void) fputs(MSG_INTL(MSG_DBG_DFLT_FMT), dbg_ofile_fptr());
 
 	if (DBG_ISTIME()) {
 		Conv_time_buf_t	buf;
@@ -225,7 +239,7 @@ dbg_print(Lm_list *lml, const char *format, ...)
 	}
 
 	va_start(args, format);
-	(void) vfprintf(dbg_ofile.fptr, format, args);
-	(void) fprintf(dbg_ofile.fptr, MSG_ORIG(MSG_STR_NL));
+	(void) vfprintf(dbg_ofile_fptr(), format, args);
+	(void) fprintf(dbg_ofile_fptr(), MSG_ORIG(MSG_STR_NL));
 	va_end(args);
 }
diff --git a/usr/src/tools/.gitignore b/usr/src/tools/.gitignore
index decfd3d58a..1987ac1f0b 100644
--- a/usr/src/tools/.gitignore
+++ b/usr/src/tools/.gitignore
@@ -22,6 +22,7 @@ __pycache__
 sgs/include/sys
 sgs/*/*.[chs]
 !sgs/sgsmsg/sgsmsg.c
+!sgs/native/*.[chs]
 
 svc/libsqlite/*.[ch]
 svc/svccfg/svccfg_grammar.[ch]
diff --git a/usr/src/tools/sgs/Makefile b/usr/src/tools/sgs/Makefile
index cd407f0709..0e30f96950 100644
--- a/usr/src/tools/sgs/Makefile
+++ b/usr/src/tools/sgs/Makefile
@@ -25,6 +25,7 @@ install :=	TARGET= install
 clean :=	TARGET= clean
 clobber :=	TARGET= clobber
 
+sgsmsg: include
 ld: sgsmsg include libconv libelf libld
 libconv: sgsmsg include
 libelf: sgsmsg include
@@ -33,7 +34,15 @@ liblddbg: sgsmsg libconv include
 
 all install clean clobber: $(SUBDIRS)
 
+#
+# ROOTONBLD (set by Makefile.tools) and ONBLD_TOOLS (set by Makefile.master)
+# both have defaults, so values given on this make's command line do not reach
+# the sub-makes.  Forward them explicitly when set, so that this tree can be
+# built and installed somewhere other than the in-tree proto area.  ONBLD_TOOLS
+# matters because libconv and friends run the sgsmsg built here, and find it
+# under $(ONBLD_TOOLS)/bin/$(MACH).
+#
 $(SUBDIRS): FRC
-	@cd $@; pwd; $(MAKE) $(TARGET)
+	@cd $@; pwd; $(MAKE) $(TARGET) $(ROOTONBLD:%=ROOTONBLD=%) $(ONBLD_TOOLS:%=ONBLD_TOOLS=%)
 
 FRC:
diff --git a/usr/src/tools/sgs/Makefile.com b/usr/src/tools/sgs/Makefile.com
index 16108d8f96..d1a86a0618 100644
--- a/usr/src/tools/sgs/Makefile.com
+++ b/usr/src/tools/sgs/Makefile.com
@@ -13,4 +13,75 @@
 
 CPPFLAGS =	-I. -I$(SRCDIR) -I$(SRCDIR)/common \
 	-I$(SGSHOME)/include -I$(SGSHOME)/include/$(MACH) \
-	-I../include $(CPPFLAGS.native) -I$(ELFCAP) -DNATIVE_BUILD
+	-I../include $(CPPFLAGS.native) -I$(ELFCAP) -DNATIVE_BUILD \
+	-I$(SRC)/tools/sgs/native -include $(SRC)/tools/sgs/native/native_compat.h
+
+#
+# The host link-editor is not illumos' -- it understands neither illumos ld's
+# options nor its mapfiles.  (That is the whole reason this native build
+# exists: to produce an ld that does.)  Empty the macros the shared makefiles
+# feed into LDFLAGS and DYNFLAGS, rather than trying to filter them back out.
+#
+BDIRECT=
+BLOCAL=
+BREDUCE=
+ZDEFS=
+ZDIRECT=
+ZIGNORE=
+ZINTERPOSE=
+ZLAZYLOAD=
+ZLOADFLTR=
+ZNOLAZYLOAD=
+ZNOLDYNSYM=
+ZRECORD=
+ZREDLOCSYM=
+ZTEXT=
+ZVERBOSE=
+ZASSERTDEFLIB=
+ZGUIDANCE=
+ZFATALWARNINGS=
+ZASLR=
+LDCHECKS=
+NATIVE_LIBS=
+
+# cw turns $(SAVEARGS) into gcc's -msave-args, which only illumos' gcc has.
+SAVEARGS=
+
+MAPFILE.NED=
+MAPFILE.PGA=
+MAPFILE.NES=
+MAPFILE.FLT=
+MAPFILE.NGB=
+MAPFILE.INT=
+MAPFILES=
+DYNFLAGS_MAPFILES=
+
+# -ulink_ver_string exists to drag libconv's vernote.o in; that object is
+# generated by illumos-only tooling and carries nothing ld needs.
+VERSREF=
+
+#
+# There is no CTF, no mcs and no strip for these objects: they are build
+# tools, not deliverables.  Reduce every post-processing step to a no-op --
+# and to `:' rather than nothing, since the shared makefiles splice these
+# into compound `a ; b' command lines.
+#
+CTFCONVERT_POST=	:
+CTFMERGE_POST=		:
+POST_PROCESS_O=		:
+POST_PROCESS_S_O=	:
+POST_PROCESS_CC_O=	:
+POST_PROCESS_A=		:
+POST_PROCESS_SO=	:
+POST_PROCESS=		:
+PROCESS_CTF=		:
+STRIP_STABS=		:
+
+#
+# lib/Makefile.lib builds DYNFLAGS out of the macros emptied above, and the
+# cmd/sgs library makefiles then append illumos ld's `-R' (which GNU ld spells
+# `-rpath').  Restate it rather than patch it up piecemeal.  $$ORIGIN survives
+# because the loader, not the link-editor, expands it, and GNU ld only has to
+# copy the string through.
+#
+DYNFLAGS=	$(HSONAME) -Wl,-rpath,'$$ORIGIN'
diff --git a/usr/src/tools/sgs/include/Makefile b/usr/src/tools/sgs/include/Makefile
index e97e7564b3..02af682cbe 100644
--- a/usr/src/tools/sgs/include/Makefile
+++ b/usr/src/tools/sgs/include/Makefile
@@ -31,6 +31,11 @@ ROOTHDRS=	dlfcn.h \
 		libelf.h \
 		proc_service.h \
 		rtld_db.h \
+		elf.h \
+		procfs.h \
+		nlist.h \
+		syms.h \
+		storclass.h \
 		link.h
 
 SYSHDRS=	sys/elf.h \
@@ -43,10 +48,19 @@ SYSHDRS=	sys/elf.h \
 		sys/auxv_SPARC.h \
 		sys/auxv_386.h \
 		sys/avl.h \
+		sys/avl_impl.h \
 		sys/link.h \
 		sys/machelf.h \
 		sys/note.h \
-		sys/systeminfo.h
+		sys/debug.h \
+		sys/secflags.h \
+		sys/sysmacros.h \
+		sys/isa_defs.h \
+		sys/feature_tests.h \
+		sys/stddef.h \
+		sys/procset.h \
+		sys/ctype.h \
+		sys/ccompile.h
 
 sys:
 	$(MKDIR) -p sys
diff --git a/usr/src/tools/sgs/ld/Makefile b/usr/src/tools/sgs/ld/Makefile
index b123f5887a..4036a41457 100644
--- a/usr/src/tools/sgs/ld/Makefile
+++ b/usr/src/tools/sgs/ld/Makefile
@@ -26,10 +26,21 @@ include		../../Makefile.tools
 include		$(SRC)/cmd/sgs/ld/Makefile.com
 include		../Makefile.com
 
-LDLIBS =	-lumem -L../libconv -L$(ROOTONBLDLIBMACH64) -lld -lelf -lconv
-NATIVE_LIBS +=	libc.so libumem.so
-MAPFILES =	$(SRCDIR)/common/mapfile-intf
-RPATH =		'-R$$ORIGIN/../../lib/$(MACH)/64'
+#
+# -lumem is dropped: nothing under cmd/sgs calls a umem_* interface, it is
+# linked purely as a faster malloc, and libumem is illumos'.
+#
+LDLIBS =	-L../libconv -L$(ROOTONBLDLIBMACH64) -lld -lelf -lconv
+NATIVE_LIBS +=	libc.so
+
+#
+# mapfile-intf is written in illumos mapfile syntax, which is precisely what
+# the host link-editor cannot read -- and what the ld being built here exists
+# to provide.  It only restricts symbol visibility, so dropping it costs
+# nothing for a build tool.
+#
+MAPFILES =
+RPATH =		-Wl,-rpath,'$$ORIGIN/../../lib/$(MACH)/64'
 
 include		$(SRC)/Makefile.master.64
 include		$(SRC)/Makefile.native
diff --git a/usr/src/tools/sgs/libconv/Makefile b/usr/src/tools/sgs/libconv/Makefile
index 297978facc..b3e2aaa42f 100644
--- a/usr/src/tools/sgs/libconv/Makefile
+++ b/usr/src/tools/sgs/libconv/Makefile
@@ -33,6 +33,43 @@ CPPFLAGS +=	-I$(SRC)/lib/libc/inc -I$(ELFCAP) \
 	-I$(SRC)/common/sgsrtcid \
 	-I$(SRC)/lib/libdemangle/common
 
+#
+# Trim the library down to what ld(1) actually calls.
+#
+#  o	corenote is core-file note decoding for elfdump/mdb.  It needs
+#	<sys/procfs.h> and the whole <sys/zone.h>/<sys/tsol/label.h> chain,
+#	none of which a foreign host has.
+#  o	lddstub is ldd(1)'s, and wants dlinfo(RTLD_DI_ORIGIN) and
+#	resolvepath(2).
+#  o	vernote.o is generated by illumos-only tooling and only exists to be
+#	dragged in by -ulink_ver_string, which ../Makefile.com has emptied.
+#
+CONV_COMOBJS_1 =	$(COMOBJS:corenote.o=)
+CONV_COMOBJS =		$(CONV_COMOBJS_1:lddstub.o=)
+CONV_BLTOBJS_1 =	$(BLTOBJS:corenote_msg.o=)
+CONV_BLTOBJS =		$(CONV_BLTOBJS_1:lddstub_msg.o=)
+
+#
+# ...and add back, from ../native, the few definitions the dropped objects
+# and a foreign libc leave undefined: link_ver_string (normally vernote.o),
+# assfail3() and panic() (normally libc), and assfail() (cmd/sgs/common).
+#
+NATIVE_OBJS =	native_support.o assfail.o
+
+ASOBJS =
+OBJECTS =	$(CONV_COMOBJS) $(COMOBJS32) $(COMOBJS64) $(ELFCAP_OBJS) \
+		$(CONV_BLTOBJS) $(NATIVE_OBJS)
+
+CPPFLAGS +=	-DLINK_VER_STRING='"$(RELEASE) (illumos, native)"'
+
+pics/native_support.o:	$(SRC)/tools/sgs/native/native_support.c
+		$(COMPILE.c) $(C_PICFLAGS) -o $@ $(SRC)/tools/sgs/native/native_support.c
+		$(POST_PROCESS_O)
+
+pics/assfail.o:		$(SGSCOMMON)/assfail.c
+		$(COMPILE.c) $(C_PICFLAGS) -o $@ $(SGSCOMMON)/assfail.c
+		$(POST_PROCESS_O)
+
 include		$(SRC)/Makefile.native
 include		$(SRC)/Makefile.master.64
 
diff --git a/usr/src/tools/sgs/libld/Makefile b/usr/src/tools/sgs/libld/Makefile
index d3933709b5..3367212b74 100644
--- a/usr/src/tools/sgs/libld/Makefile
+++ b/usr/src/tools/sgs/libld/Makefile
@@ -40,9 +40,14 @@ include		../Makefile.com
 LDLIBS =	-L../libconv -lconv -L$(ROOTONBLDLIBMACH64) -llddbg -lelf -lc
 NATIVE_LIBS +=	libc.so
 
+#
+# -I$(SRC)/uts/common is deliberately absent: it would put illumos'
+# <sys/types.h> and <sys/int_types.h> ahead of the host's, and the two
+# redefine each other's fixed-width integer types.  The uts headers libld
+# genuinely wants are staged into ../include instead.
+#
 CPPFLAGS += -DUSE_LIBLD_MALLOC -I$(SRC)/lib/libc/inc \
-	    -I$(SRC)/uts/common/krtld -I$(SRC)/uts/sparc \
-	    -I$(SRC)/uts/common
+	    -I$(SRC)/uts/common/krtld
 
 DYNFLAGS +=	$(VERSREF) '-Wl,-R$$ORIGIN'
 
diff --git a/usr/src/tools/sgs/native/native_compat.h b/usr/src/tools/sgs/native/native_compat.h
new file mode 100644
index 0000000000..ff62f992f1
--- /dev/null
+++ b/usr/src/tools/sgs/native/native_compat.h
@@ -0,0 +1,168 @@
+/*
+ * This file and its contents are supplied under the terms of the
+ * Common Development and Distribution License ("CDDL"), version 1.0.
+ * You may only use this file in accordance with the terms of version
+ * 1.0 of the CDDL.
+ *
+ * A full copy of the text of the CDDL should have accompanied this
+ * source.  A copy of the CDDL is also available via the Internet at
+ * http://www.illumos.org/license/CDDL.
+ */
+
+/*
+ * Compatibility shims for building the native link-editor on a host whose
+ * libc is not illumos'.  Force-included (via -include) from
+ * tools/sgs/Makefile.com, so it must be safe to include first, before
+ * anything else.
+ *
+ * The headers staged by tools/sgs/include are illumos' own, and they expect
+ * illumos' <sys/types.h> to have already supplied the "_t" spellings of the
+ * base integer types and boolean_t.  A foreign libc supplies none of that,
+ * so define it here.  Nothing in here is illumos-specific behaviour; it is
+ * purely the vocabulary the staged headers assume.
+ */
+
+#ifndef	_SGS_NATIVE_COMPAT_H
+#define	_SGS_NATIVE_COMPAT_H
+
+
+/*
+ * On illumos every sys header reaches <sys/isa_defs.h> by way of
+ * <sys/param.h>.  Here <sys/param.h> is the host's, so the staged illumos
+ * headers would never see _BIT_FIELDS_LTOH, _LP64 and friends.  Pull it in
+ * up front instead.
+ */
+#include <sys/isa_defs.h>
+
+/*
+ * <sys/ccompile.h> supplies __GNU_INLINE and the __sun_attr__ family that the
+ * staged headers use; on illumos it too arrives via <sys/types.h>.
+ */
+#include <sys/ccompile.h>
+
+#include <stddef.h>
+#include <stdint.h>
+#include <sys/types.h>
+/*
+ * illumos' <strings.h> pulls in <string.h>; the host's does not, and the sgs
+ * sources rely on the illumos behaviour.
+ */
+#include <string.h>
+#include <strings.h>
+
+#ifdef	__cplusplus
+extern "C" {
+#endif
+
+#ifndef	_BOOLEAN_T
+#define	_BOOLEAN_T
+typedef enum { B_FALSE, B_TRUE } boolean_t;
+#endif
+
+typedef unsigned char		uchar_t;
+typedef unsigned short		ushort_t;
+typedef unsigned int		uint_t;
+typedef unsigned long		ulong_t;
+typedef long long		longlong_t;
+typedef unsigned long long	u_longlong_t;
+typedef long long		hrtime_t;
+
+
+/*
+ * illumos' <sys/sysmacros.h> carries these; the host's has only the
+ * major/minor/makedev trio, so a bare #include silently loses them.
+ */
+#ifndef	MAX
+#define	MAX(a, b)	((a) < (b) ? (b) : (a))
+#endif
+#ifndef	MIN
+#define	MIN(a, b)	((a) > (b) ? (b) : (a))
+#endif
+#ifndef	ABS
+#define	ABS(a)		((a) < 0 ? -(a) : (a))
+#endif
+#ifndef	howmany
+#define	howmany(x, y)	(((x) + ((y) - 1)) / (y))
+#endif
+#ifndef	roundup
+#define	roundup(x, y)	((((x) + ((y) - 1)) / (y)) * (y))
+#endif
+#ifndef	P2ROUNDUP
+#define	P2ROUNDUP(x, align)	(-(-(x) & -(align)))
+#endif
+#ifndef	P2PHASE
+#define	P2PHASE(x, align)	((x) & ((align) - 1))
+#endif
+#ifndef	P2ALIGN
+#define	P2ALIGN(x, align)	((x) & -(align))
+#endif
+#ifndef	P2NPHASE
+#define	P2NPHASE(x, align)	(-(x) & ((align) - 1))
+#endif
+#ifndef	IS_P2ALIGNED
+#define	IS_P2ALIGNED(v, a)	((((uintptr_t)(v)) & ((uintptr_t)(a) - 1)) == 0)
+#endif
+
+/*
+ * auxv_t, which liblddbg's interfaces take by pointer.  On illumos it
+ * arrives through the <sys/procfs.h> chain; here that chain is the host's.
+ * This resolves to the staged illumos header, not the host's <sys/auxv.h>,
+ * and must come after the typedefs above.
+ */
+#include <sys/auxv.h>
+
+/*
+ * illumos' <sys/int_types.h> announces the availability of 64-bit integer
+ * types this way, and <gelf.h> refuses to compile without it.  We are not
+ * staging <sys/int_types.h> -- it redefines the whole intN_t family and
+ * collides with the host's <stdint.h> -- so state the fact directly.
+ */
+#ifndef	_INT64_TYPE
+#define	_INT64_TYPE
+#endif
+#ifndef	_LONGLONG_TYPE
+#define	_LONGLONG_TYPE
+#endif
+
+/*
+ * illumos' <sys/param.h> exposes the runtime page size as PAGESIZE.
+ */
+#ifndef	PAGESIZE
+#include <unistd.h>
+#define	PAGESIZE	((size_t)sysconf(_SC_PAGESIZE))
+#endif
+
+/*
+ * From illumos' <sys/time.h>.
+ */
+#ifndef	SEC
+#define	SEC		1
+#endif
+#ifndef	MILLISEC
+#define	MILLISEC	1000
+#endif
+#ifndef	MICROSEC
+#define	MICROSEC	1000000
+#endif
+#ifndef	NANOSEC
+#define	NANOSEC		1000000000
+#endif
+
+/*
+ * From illumos' <limits.h>; the host's has no notion of message catalogues.
+ */
+#ifndef	NL_MSGMAX
+#define	NL_MSGMAX	32767
+#endif
+#ifndef	NL_SETMAX
+#define	NL_SETMAX	255
+#endif
+#ifndef	NL_TEXTMAX
