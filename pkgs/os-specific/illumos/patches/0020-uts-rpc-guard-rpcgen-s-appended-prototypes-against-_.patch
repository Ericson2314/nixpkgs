From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: John Ericson <John.Ericson@Obsidian.Systems>
Date: Sun, 9 Aug 2026 20:18:58 -0400
Subject: [PATCH] uts/rpc: guard rpcgen's appended prototypes against `_KERNEL`

`uts/common/rpc/pmap_prot.h` is generated by `rpcgen -M -h`. The definitions
in `pmap_prot.x` sit inside the `#ifndef _KERNEL` arm of the header -- the
kernel gets a hand-written `struct pmap` from the `#else` arm instead -- but
the xdr and stub prototypes `rpcgen` appends at the end of the file land
*after* the matching `#endif`. They name the lowercase typedefs (`pmap`,
`pm__list`, `rmtcallargs`, `rmtcallres`) that only exist in the non-kernel
arm, so any kernel translation unit including `<rpc/pmap_prot.h>` fails with

    ../../common/rpc/pmap_prot.h:231:24: error: unknown type name 'pmap'

`uts/common/inet/tcp/tcp.c` and `tcp_bind.c` both include it (for
`PMAPPORT`), so this is exactly what stops `drv/tcp` from compiling.

illumos' own `rpcgen` does not produce the trailing block -- it emits each
`xdr_*()` prototype immediately after the definition it belongs to, i.e.
inside the guard. The problem only appears when the build host supplies a
different `rpcgen` (NetBSD's, in a cross build).

Guard the appended declarations rather than dropping them: this header is
also installed into `/usr/include`, where userland does use them. The
`PMAPPROG`/`PMAPVERS`/`PMAPPROC_*` defines are left alone, since
`rpc_subr.c` and `nfs_dlinet.c` need them in the kernel.

Assisted-By: Claude <noreply@anthropic.com>
---
 usr/src/uts/common/rpc/Makefile | 20 ++++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/usr/src/uts/common/rpc/Makefile b/usr/src/uts/common/rpc/Makefile
index 8ae5ac2e46..073de1bcfe 100644
--- a/usr/src/uts/common/rpc/Makefile
+++ b/usr/src/uts/common/rpc/Makefile
@@ -104,8 +104,28 @@ $(RPCSVCDIRS):
 key_prot.h: key_prot.x
 	$(RPCGEN) -C -h key_prot.x > $@
 
+#
+# The trailing declaration blocks rpcgen appends -- the xdr_*() prototypes and
+# the client/server stub prototypes -- name the lowercase typedefs it generated
+# for the definitions in pmap_prot.x.  Those definitions sit inside the
+# `#ifndef _KERNEL` arm of this header (see the %-passthrough at the top of
+# pmap_prot.x), while the appended blocks land after the matching #endif, so a
+# kernel compilation of <rpc/pmap_prot.h> sees prototypes referring to types
+# that were never declared: "unknown type name 'pmap'".
+#
+# illumos' own rpcgen does not hit this, because it emits each xdr_*()
+# prototype immediately after the definition it belongs to -- i.e. inside the
+# guard.  A build using another rpcgen (NetBSD's, when cross-building from a
+# host with no illumos rpcgen) appends them instead.  Guard them here rather
+# than deleting them: this header is installed into /usr/include as well, and
+# userland genuinely uses those prototypes.
+#
+# Only declarations are touched, so the #define PMAPPROG/PMAPVERS/PMAPPROC_*
+# block stays visible to the kernel, which uses it (uts/common/rpc/rpc_subr.c,
+# uts/common/fs/nfs/nfs_dlinet.c).
 pmap_prot.h: pmap_prot.x
 	$(RPCGEN) -M -h pmap_prot.x > $@
+	$(SED) -i -e '/ndef _KERNEL \*\//,$$ s|^\([a-z].*(.*);\)$$|#ifndef _KERNEL\n\1\n#endif|' $@
 
 rpc_sztypes.h: rpc_sztypes.x
 	$(RPCGEN) -C -h rpc_sztypes.x > $@
