@@ -339,8 +331,7 @@ CCNOAUTOINLINE= \
 	-_gcc=-fno-inline-small-functions \
 	-_gcc=-fno-inline-functions-called-once \
 	-_gcc=-fno-ipa-cp \
-	-_gcc=-fno-ipa-icf \
-	-_gcc=-fno-clone-functions
+	-_gcc=-fno-ipa-icf
 
 # GCC may put functions in different named sub-sections of .text based on
 # their presumed calling frequency.  At least in the kernel, where we actually
@@ -436,7 +427,11 @@ STAND_FLAGS_64 = $($(MACH64)_STAND_FLAGS)
 
 #
 # turn warnings into errors (C)
-CERRWARN = -errtags=yes -errwarn=%all
+#
+# Cross-building against a different compiler and libc headers than the ones
+# illumos itself uses turns up warnings the in-tree build never sees, so
+# -errwarn=%all is dropped here.
+CERRWARN = -errtags=yes
 
 CERRWARN += -_gcc=-Wno-missing-braces
 CERRWARN += -_gcc=-Wno-sign-compare
@@ -453,7 +448,7 @@ include $(SRC)/Makefile.smatch
 
 #
 # turn warnings into errors (C++)
-CCERRWARN = -errtags=yes -errwarn=%all
+CCERRWARN = -errtags=yes
 
 CCERRWARN += -_gcc=-Wno-missing-braces
 CCERRWARN += -_gcc=-Wno-sign-compare
@@ -611,9 +606,9 @@ DCMSGDOMAINPOFILE = $(DCMSGDOMAIN)/$(DCFILE:.dc=.po)
 
 CLOBBERFILES += $(POFILE) $(POFILES)
 COMPILE.cpp= $(CC) -E -C $(CFLAGS) $(CPPFLAGS)
-XGETTEXT= /usr/bin/xgettext
+XGETTEXT= xgettext
 XGETFLAGS= -c TRANSLATION_NOTE
-GNUXGETTEXT= /usr/gnu/bin/xgettext
+GNUXGETTEXT= xgettext
 GNUXGETFLAGS= --add-comments=TRANSLATION_NOTE --keyword=_ \
 	--strict --no-location --omit-header
 BUILD.po= $(XGETTEXT) $(XGETFLAGS) -d $(<F) $<.i ;\
@@ -745,34 +740,64 @@ NATIVE_MACH64=	$(MACH64)
 # environment.
 GNU_ROOT=		/usr
 
-PRIMARY_CC=	gcc10,$(GNUC_ROOT)/bin/gcc,gnu
-PRIMARY_CCC=	gcc10,$(GNUC_ROOT)/bin/g++,gnu
+# Note that these read *environment* variables, not make macros.
+#
+# The names are deliberately not $CC/$LD. SunPro make remembers which macros
+# it imported from the environment, and re-exports them with their new value
+# whenever the makefile reassigns them (lib/mksh/macro.cc:1220, "For
+# environment variables we also set the environment value each time"). Since
+# this file goes on to define the macros CC and LD (below, "Makefile.master.64
+# overrides these settings"), a recursive $(MAKE) inherits $CC in its
+# environment as the whole expanded "cw --tag target ... --" command line --
+# and `command -v $CC` then resolves to cw, which cw is duly handed as its own
+# primary compiler. $ILLUMOS_CC and $ILLUMOS_LD are never make macros, so they
+# survive any depth of recursion unchanged.
+PRIMARY_CC_PATH:sh = command -v "$ILLUMOS_CC" 2>/dev/null || :
+PRIMARY_CCC_PATH:sh = command -v "$CXX" 2>/dev/null || :
+
+PRIMARY_CC=	gcc10,$(PRIMARY_CC_PATH),gnu
+PRIMARY_CCC=	gcc10,$(PRIMARY_CCC_PATH),gnu
 
 CW_CC_COMPILERS=	$(PRIMARY_CC:%=--primary %) $(SHADOW_CCS:%=--shadow %)
 CW_CCC_COMPILERS=	$(PRIMARY_CCC:%=--primary %) $(SHADOW_CCCS:%=--shadow %)
 
 CW_LINKER=		--linker $(LD)
 
+# The NATIVE* compilers build programs that run on the machine doing the
+# build, not on the target. When cross-compiling these are different
+# compilers, so they come from $CC_FOR_BUILD/$CXX_FOR_BUILD rather than
+# $CC/$CXX. They fall back to the target compiler, which is correct for a
+# native build where the two coincide.
+NATIVE_PRIMARY_CC_PATH:sh = command -v "$CC_FOR_BUILD" 2>/dev/null || command -v "$ILLUMOS_CC" 2>/dev/null || :
+NATIVE_PRIMARY_CCC_PATH:sh = command -v "$CXX_FOR_BUILD" 2>/dev/null || command -v "$CXX" 2>/dev/null || :
+
+NATIVE_PRIMARY_CC=	gcc10,$(NATIVE_PRIMARY_CC_PATH),gnu
+NATIVE_PRIMARY_CCC=	gcc10,$(NATIVE_PRIMARY_CCC_PATH),gnu
+
+CW_NATIVE_CC_COMPILERS=		$(NATIVE_PRIMARY_CC:%=--primary %)
+CW_NATIVE_CCC_COMPILERS=	$(NATIVE_PRIMARY_CCC:%=--primary %)
+
+
 # Specify platform compiler versions for languages
 # that we use (currently only c and c++).
 #
-CW=			$(ONBLD_TOOLS)/bin/$(MACH)/cw
-NATIVE_CW=		$(ONBLD_TOOLS)/bin/$(MACH)/cw
+CW=			cw
+NATIVE_CW=		cw
 
 BUILD_CC=		$(CW) $(CWOPTS) --tag target $(CW_LINKER) \
 	$(CW_CC_COMPILERS) --
 BUILD_CCC=		$(CW) $(CWOPTS) --tag target -C $(CW_LINKER) \
 	$(CW_CCC_COMPILERS) --
-BUILD_CPP=		/usr/lib/cpp
-BUILD_LD=		$(ONBLD_TOOLS)/bin/$(MACH64)/ld
+BUILD_CPP=		$(BUILD_CC) -E
+BUILD_LD:sh=		command -v "$ILLUMOS_LD" 2>/dev/null || :
 BUILD_AS=		$(BUILD_CC)
 
-NATIVEBUILD_CC=		$(NATIVE_CW) $(CWOPTS) --tag native $(CW_LINKER) \
-	$(CW_CC_COMPILERS) --
-NATIVEBUILD_CCC=	$(NATIVE_CW) $(CWOPTS) --tag native -C $(CW_LINKER) \
-	$(CW_CCC_COMPILERS) --
-NATIVEBUILD_CPP=	/usr/lib/cpp
-NATIVEBUILD_LD=		$(ONBLD_TOOLS)/bin/$(MACH64)/ld
+NATIVEBUILD_CC=		$(NATIVE_CW) $(CWOPTS) --tag native \
+	$(CW_NATIVE_CC_COMPILERS) --
+NATIVEBUILD_CCC=	$(NATIVE_CW) $(CWOPTS) --tag native -C \
+	$(CW_NATIVE_CCC_COMPILERS) --
+NATIVEBUILD_CPP=	$(NATIVEBUILD_CC) -E
+NATIVEBUILD_LD:sh=		command -v "$LD_FOR_BUILD" 2>/dev/null || :
 NATIVEBUILD_AS=		$(NATIVEBUILD_CC)
 
 $(MACH)_CC=		$(BUILD_CC)
@@ -959,8 +984,8 @@ BOOTBANNER3=
 BOOTBANNER4=
 BOOTBANNER5=
 
-PROCESS_COMMENT=  @?${MCS} -d -a $(RELEASE_CM) -a $(DEV_CM)
-$(RELEASE_BUILD)PROCESS_COMMENT=   @?${MCS} -d -a $(RELEASE_CM)
+PROCESS_COMMENT=  :
+#$(RELEASE_BUILD)PROCESS_COMMENT=   @?${MCS} -d -a $(RELEASE_CM)
 
 STRIP_STABS=			   $(STRIP) -x $@
 $(SRCDBGBLD)STRIP_STABS=	   :
