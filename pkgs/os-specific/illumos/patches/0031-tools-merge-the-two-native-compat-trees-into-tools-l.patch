diff --git a/usr/src/tools/Makefile.tools b/usr/src/tools/Makefile.tools
index 0af0719eed..4096130de8 100644
--- a/usr/src/tools/Makefile.tools
+++ b/usr/src/tools/Makefile.tools
@@ -62,6 +62,23 @@ LDFLAGS=
 
 NATIVE_LIBS += libc.so
 
+#
+# libcompat: what it takes to compile gate source on a host whose libc is not
+# illumos'.  One place, named once, rather than each bootstrap tool spelling
+# out its own -I/-include and growing its own copy of the shims next to it --
+# which is how tools/ctf/native and tools/sgs/native came to be two versions
+# of the same thing.
+#
+# COMPAT_CPPFLAGS is the header half; the force-include has to come first, so
+# it is safe to include before anything else by construction.
+# COMPAT_SUPPORT_SRC is the handful of libc entry points a foreign libc lacks
+# (assfail(), panic(), getexecname(), strtonum(), link_ver_string), compiled
+# into whichever library the consumer already links.
+#
+COMPAT_DIR=		$(SRC)/tools/libcompat/common
+COMPAT_CPPFLAGS=	-I$(COMPAT_DIR) -include $(COMPAT_DIR)/native_compat.h
+COMPAT_SUPPORT_SRC=	$(COMPAT_DIR)/native_support.c
+
 # To work around a bootstrapping problem, we can't rely on cw(1) knowing how
 # to translate -shared as we may be using an older one to build the current
 # tools.
diff --git a/usr/src/tools/ctf/Makefile.ctf.native b/usr/src/tools/ctf/Makefile.ctf.native
index 5be6d11259..b9f9aff939 100644
--- a/usr/src/tools/ctf/Makefile.ctf.native
+++ b/usr/src/tools/ctf/Makefile.ctf.native
@@ -23,6 +23,11 @@
 # Makefile.master and would undo every assignment below.
 #
 
+#
+# $(COMPAT_CPPFLAGS) is both halves of libcompat's header profile: the
+# force-include, and a -I that lands ahead of the host's own directories --
+# unlike the -idirafter below.  That ordering is deliberate: libcompat holds
+# the handful of headers where the host has an opinion and it is the wrong one.
 #
 # The force-include covers the translation units that reach illumos headers on
 # their own (libdwarf, avl.c, list.c, mergeq).  -DCTF_NATIVE_COMPAT covers the
@@ -30,15 +35,9 @@
 # makefiles, and -include options are processed in the order given, so the
 # shims have to be pulled in from inside that header to land ahead of it.
 #
-CPPFLAGS +=	-include $(SRC)/tools/ctf/native/native_compat.h
+CPPFLAGS +=	$(COMPAT_CPPFLAGS)
 CPPFLAGS +=	-DCTF_NATIVE_COMPAT
 
-#
-# Ahead of the host's own directories, unlike the -idirafter below: this holds
-# the handful of headers where the host has an opinion and it is the wrong one.
-#
-CPPFLAGS +=	-I$(SRC)/tools/ctf/native
-
 #
 # $(SRC)/uts/common holds both headers illumos does not ship (<sys/ctf.h>,
 # <sys/ctf_api.h>, <sys/list.h>) and headers every libc has (<sys/types.h>).
diff --git a/usr/src/tools/ctf/libctf/Makefile.com b/usr/src/tools/ctf/libctf/Makefile.com
index fcc0fc0160..587b61a8b6 100644
--- a/usr/src/tools/ctf/libctf/Makefile.com
+++ b/usr/src/tools/ctf/libctf/Makefile.com
@@ -41,8 +41,8 @@ OBJECTS +=	avl.o
 LDLIBS += -lc -lelf -L$(ROOTONBLDLIBMACH) -ldwarf
 NATIVE_LIBS += libelf.so libc.so
 
-pics/native_support.o:	$(SRC)/tools/ctf/native/native_support.c
-	$(COMPILE.c) $(C_PICFLAGS) -o $@ $(SRC)/tools/ctf/native/native_support.c
+pics/native_support.o:	$(COMPAT_SUPPORT_SRC)
+	$(COMPILE.c) $(C_PICFLAGS) -o $@ $(COMPAT_SUPPORT_SRC)
 	$(POST_PROCESS_O)
 
 pics/avl.o:	$(SRC)/common/avl/avl.c
