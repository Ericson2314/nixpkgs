Make should not hit configure

We run `configure` ourselves in `configurePhase`, with the cross-compilation
arguments we want. Leaving this rule in place means `make` notices the
`config.cache` dependency and runs `configure` a second time, from within the
build, discarding that setup.

Rebased for NetBSD 11.0: upstream rewrote the rule body (it now stages through
`${.TARGET}.tmp` and passes `CPPFLAGS` and `CONFIGURE_ARGS`), so the original
context no longer applied. The change is the same one -- drop the rule.

diff --git a/tools/compat/Makefile b/tools/compat/Makefile
--- a/tools/compat/Makefile
+++ b/tools/compat/Makefile
@@ -84,15 +84,6 @@
 CONFIGURE_ARGS+=--silent
 .endif

-config.cache: include/.stamp configure nbtool_config.h.in defs.mk.in
-	rm -f ${.TARGET}.tmp ${.TARGET}
-	CC=${HOST_CC:Q} CFLAGS=${HOST_CFLAGS:Q} CPPFLAGS=${HOST_CPPFLAGS:Q} \
-		LDFLAGS=${HOST_LDFLAGS:Q} \
-		${HOST_SH} ${.CURDIR}/configure \
-		--cache-file=${.TARGET}.tmp \
-		${CONFIGURE_ARGS}
-	mv -f ${.TARGET}.tmp ${.TARGET}
-
 defs.mk: config.cache
 	@touch ${.TARGET}
